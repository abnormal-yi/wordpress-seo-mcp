# Required: 32-byte (64 hex char) key used to encrypt stored WordPress site
# credentials (Application Passwords). Generate with: openssl rand -hex 32
# IMPORTANT: keep this stable across restarts — if it changes, previously
# stored site credentials become unreadable and sites must be re-added.
SEO_ENCRYPTION_KEY=

# Optional: path to the SQLite database file (audit log, credentials, snapshots, etc.)
# Defaults to ./data/seo.db
SEO_DB_PATH=./data/seo.db

# Google Search Console (optional — GSC tools won't register without these)
GSC_API_KEY=your-google-api-key
GSC_SITE_URL=https://yoursite.com

# Optional: directory path containing external SEO plugins to load at startup.
# Each subfolder must export a valid SEOPlugin (manifest + analyze? + apply?).
# Example: SEO_PLUGINS_DIR=./my-plugins
SEO_PLUGINS_DIR=

# Optional: disable background automation rules job (set to false to turn off)
# AUTOMATION_RULES_ENABLED=true

# Optional: rate limit per site (default: 60 requests per minute)
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000
